	[77101] = {
		Title = "Chronicle 6-1: The Foreman of Einbech",
		Summary = "Travel to Einbech, the mining town of the Schwarzwald Republic, and find Foreman Gustav by the mine entrance (142, 244).",
		IconName = "ico_nq.bmp",
		Description = { "Travel to Einbech, the mining town of the Schwarzwald Republic, and find Foreman Gustav by the mine entrance (142, 244).<br><br>How to get there:<br>1. From Al De Baran, a Kafra Employee (143, 119) can teleport you to Juno (1,200 zeny).<br>2. In Juno, enter the airport in the west of the city (53, 214). Pay the Airport Staff (1,200 zeny), go through Domestic Boarding and ride the airship until it lands in Einbroch.<br>3. In Einbroch, the Train Station Staff (232, 272) takes you to Einbech for 200 zeny. Gustav stands by the mine entrance in the north of the town (142, 244) and is marked on your minimap when you arrive.<br><br>Route: <NAVI>[Foreman Gustav]<INFO>einbech,142,244,0,000,0</INFO></NAVI>" },
	},
	[77102] = {
		Title = "Chronicle 6-2: The Restless Mine",
		Summary = "Hunt 30 Pitmen and 20 Noxious on the first level of the Einbech Mine (ein_dun01). Its entrance is in the north of Einbech (138, 252).",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Pitmen and 20 Noxious on the first level of the Einbech Mine (ein_dun01). Its entrance is in the north of Einbech (138, 252).<br><br>How to get there:<br>1. The mine entrance is in the north of Einbech (138, 252), next to Foreman Gustav. Pitmen and Noxious fill its first level.<br><br>Route: <NAVI>[Hunting ground: ein_dun01]<INFO>ein_dun01,22,14,0,000,0</INFO></NAVI>" },
	},
	[77103] = {
		Title = "Chronicle 6-3: Samples for the Foreman",
		Summary = "Gustav wants to know what is poisoning his mine. Bring him 5 Old Picks from the Pitmen and 8 Dust Pollutants from the Noxious, in Einbech (142, 244).",
		IconName = "ico_nq.bmp",
		Description = { "Gustav wants to know what is poisoning his mine. Bring him 5 Old Picks from the Pitmen and 8 Dust Pollutants from the Noxious, in Einbech (142, 244).<br><br>How to get there:<br>1. Far from Einbech? From Al De Baran, a Kafra Employee (143, 119) teleports you to Juno (1,200 zeny). Juno's airship stops in Einbroch, and Einbroch's train (232, 272) runs to Einbech (200 zeny).<br><br>Route: <NAVI>[Foreman Gustav]<INFO>einbech,142,244,0,000,0</INFO></NAVI>" },
	},
	[77104] = {
		Title = "Chronicle 6-4: The Black Seam",
		Summary = "Descend to the second level of the Einbech Mine (ein_dun02). The way down is at the far north-east end of the first level (261, 255).",
		IconName = "ico_nq.bmp",
		Description = { "Descend to the second level of the Einbech Mine (ein_dun02). The way down is at the far north-east end of the first level (261, 255).<br><br>How to get there:<br>1. Enter the mine in the north of Einbech (138, 252).<br>2. Mine level 1: cross to its north-east corner (261, 255) and take the way down to level 2. The Warden of the Black Crystal appears a few seconds after you arrive.<br><br>Route: <NAVI>[Warden of the Black Crystal: ein_dun02]<INFO>ein_dun02,291,292,0,000,0</INFO></NAVI>" },
	},
	[77105] = {
		Title = "Chronicle 6-5: Crystal and Steel",
		Summary = "Bring Foreman Gustav in Einbech (142, 244) news of the Warden.",
		IconName = "ico_nq.bmp",
		Description = { "Bring Foreman Gustav in Einbech (142, 244) news of the Warden.<br><br>How to get there:<br>1. Far from Einbech? From Al De Baran, a Kafra Employee (143, 119) teleports you to Juno (1,200 zeny). Juno's airship stops in Einbroch, and Einbroch's train (232, 272) runs to Einbech (200 zeny).<br><br>Route: <NAVI>[Foreman Gustav]<INFO>einbech,142,244,0,000,0</INFO></NAVI>" },
	},
	[77026] = {
		Title = "Chronicle 7-1: The Sage of Juno",
		Summary = "Travel to Juno, the floating capital of the Schwarzwald Republic, and meet Sage Elisha near the southern entrance (156, 47).",
		IconName = "ico_nq.bmp",
		Description = { "Travel to Juno, the floating capital of the Schwarzwald Republic, and meet Sage Elisha near the southern entrance (156, 47).<br><br>How to get there:<br>1. From Einbech, the Train Station Staff (39, 215) takes you back to Einbroch (200 zeny).<br>2. In Einbroch, enter the airport (64, 207), pay the Airport Staff (1,200 zeny) and ride the airship until it lands in Juno. Sage Elisha stands near Juno's southern entrance (156, 47).<br><br>Route: <NAVI>[Sage Elisha]<INFO>yuno,156,47,0,000,0</INFO></NAVI>" },
	},
	[77027] = {
		Title = "Chronicle 7-2: The Waking Machines",
		Summary = "Hunt 40 Venatu in the Juperos ruins (juperos_01).",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 40 Venatu in the Juperos ruins (juperos_01).<br><br>Route: <NAVI>[Hunting ground: juperos_01]<INFO>juperos_01,54,246,0,000,0</INFO></NAVI>" },
	},
	[77028] = {
		Title = "Chronicle 7-3: Salvage",
		Summary = "Bring Sage Elisha 8 Rusty Screws and 1 Steel from the machines, in Juno (156, 47).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Sage Elisha 8 Rusty Screws and 1 Steel from the machines, in Juno (156, 47).<br><br>Route: <NAVI>[Sage Elisha]<INFO>yuno,156,47,0,000,0</INFO></NAVI>" },
	},
	[77029] = {
		Title = "Chronicle 7-4: The Core",
		Summary = "Reach the heart of the ruins, the Juperos Core (jupe_core), through the old elevator beneath Juperos. Bring 4 Crest Pieces from Venatu.",
		IconName = "ico_nq.bmp",
		Description = { "Reach the heart of the ruins, the Juperos Core (jupe_core), through the old elevator beneath Juperos. Bring 4 Crest Pieces from Venatu.<br><br>How to get there:<br>1. Collect the 4 Crest Pieces (Purple, Green, Orange, Blue). Only Venatu drop them, in the Juperos ruins. The elevator lever needs all 4.<br>2. Juperos 1: step on the strange spot at (100, 91) and agree, or wait 10 seconds. You drop down to Juperos 2.<br>3. Juperos 2: destroy the 3 Gate Switches on the outer islands, at (24, 275), (240, 29) and (282, 183). The ground shakes, and a portal opens in the centre (130, 149) for about 10 minutes. Broken switches come back after 20 minutes.<br>4. Security halls: each pedestal checks one Crest Piece (it is not taken). Then an alarm sends Venatu and Dimik at you. Survive, and a portal takes you on.<br>5. Elevator room: put all 4 Crest Pieces in the lever (they are used up) and pull it. Defeat the 9 guards within 2 minutes, or you are thrown out.<br>6. Elevator ride: 4 waves of 8 guards, a new wave every 30 seconds. Kill all 32 within about 2 minutes, or you are thrown out to the gate hall (the 4 pieces are lost). When the last one falls, step on the portal at (41, 33), or wait and you are moved to the Core anyway. The Awakened Core Guardian rises a few seconds later.<br>7. If you fall in the elevator, the lever has kept your 4 pieces. Bring a new set of 4 and start again from Juperos 1. The elevator rooms only work while the lever is running, so no Warper or teleport can take you there.<br><br>Route: <NAVI>[The way down: juperos_01]<INFO>juperos_01,100,91,0,000,0</INFO></NAVI>" },
	},
	[77030] = {
		Title = "Chronicle 7-5: The Guardians' Purpose",
		Summary = "Report to Sage Elisha in Juno (156, 47).",
		IconName = "ico_nq.bmp",
		Description = { "Report to Sage Elisha in Juno (156, 47).<br><br>Route: <NAVI>[Sage Elisha]<INFO>yuno,156,47,0,000,0</INFO></NAVI>" },
	},
	[77106] = {
		Title = "Chronicle 8-1: Through the Rift",
		Summary = "Go through the rift under Morroc to the Allied Forces Post, and find Captain Varrick in the camp (200, 282).",
		IconName = "ico_nq.bmp",
		Description = { "Go through the rift under Morroc to the Allied Forces Post, and find Captain Varrick in the camp (200, 282).<br><br>How to get there:<br>1. From Morroc, follow the Route link to the Allied Scout on the Sograt Desert east of the city (moc_fild20, 345, 182), next to the rift guards.<br>2. Show him your Chronicle and choose to go through. He sends you to the Allied Forces Post (mid_camp), where Captain Varrick stands near the arrival spot (200, 282).<br><br>Route: <NAVI>[Allied Scout: moc_fild20]<INFO>moc_fild20,345,182,0,000,0</INFO></NAVI>" },
	},
	[77107] = {
		Title = "Chronicle 8-2: The Wild Fields",
		Summary = "Hunt 30 Naga and 20 Cornus in the fields north of Splendide (spl_fild01).",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Naga and 20 Cornus in the fields north of Splendide (spl_fild01).<br><br>How to get there:<br>1. The camp's gate guards only let the Expedition's own people out. Take the Teleport Cat in the camp (207, 234) to Near Splendide (10,000 zeny).<br>2. You arrive on spl_fild02. Its way north (293, 379) leads to spl_fild01, the hunting ground.<br><br>Route: <NAVI>[Hunting ground: spl_fild01]<INFO>spl_fild01,289,30,0,000,0</INFO></NAVI>" },
	},
	[77108] = {
		Title = "Chronicle 8-3: Proof of Good Faith",
		Summary = "Varrick wants proof to show the Laphine. Bring him 8 Scale Shells from the Naga and 8 Mystic Horns from the Cornus, in the Allied camp (200, 282).",
		IconName = "ico_nq.bmp",
		Description = { "Varrick wants proof to show the Laphine. Bring him 8 Scale Shells from the Naga and 8 Mystic Horns from the Cornus, in the Allied camp (200, 282).<br><br>How to get there:<br>1. From spl_fild01, the way south (289, 28) leads back to spl_fild02. Its east edge (382, 143) leads into the camp.<br><br>Route: <NAVI>[Captain Varrick]<INFO>mid_camp,200,282,0,000,0</INFO></NAVI>" },
	},
	[77109] = {
		Title = "Chronicle 8-4: The Rift-Mad Beast",
		Summary = "Go to Manuk Field (man_fild02), the Sapha's land, and put down the Rift-Mad Tatacho.",
		IconName = "ico_nq.bmp",
		Description = { "Go to Manuk Field (man_fild02), the Sapha's land, and put down the Rift-Mad Tatacho.<br><br>How to get there:<br>1. Take the Teleport Cat in the camp (207, 234) to Manuk Field (10,000 zeny). The Rift-Mad Tatacho appears a few seconds after you arrive.<br><br>Route: <NAVI>[Rift-Mad Tatacho: man_fild02]<INFO>man_fild02,133,47,0,000,0</INFO></NAVI>" },
	},
	[77110] = {
		Title = "Chronicle 8-5: A Word from the Sapha",
		Summary = "Return to Captain Varrick in the Allied camp (200, 282).",
		IconName = "ico_nq.bmp",
		Description = { "Return to Captain Varrick in the Allied camp (200, 282).<br><br>How to get there:<br>1. From Manuk Field, the Teleport Cat (135, 49) takes you back to the Allied camp (10,000 zeny). Or walk west: man_fild01's west edge (35, 232) leads into the camp.<br><br>Route: <NAVI>[Captain Varrick]<INFO>mid_camp,200,282,0,000,0</INFO></NAVI>" },
	},
	[77111] = {
		Title = "Chronicle 9-1: The Warden of El Dicastes",
		Summary = "Go to Kamidal Mountain and find Warden Kahlis outside the gate of El Dicastes (dic_fild01, 156, 270).",
		IconName = "ico_nq.bmp",
		Description = { "Go to Kamidal Mountain and find Warden Kahlis outside the gate of El Dicastes (dic_fild01, 156, 270).<br><br>How to get there:<br>1. From the Allied camp, take the Teleport Cat (207, 234) to Manuk Field (10,000 zeny).<br>2. On Manuk Field, the Teleport Cat (135, 49) goes to Near El Dicastes (20,000 zeny). Warden Kahlis stands just south of the city gate (156, 270).<br><br>Route: <NAVI>[Warden Kahlis]<INFO>dic_fild01,156,270,0,000,0</INFO></NAVI>" },
	},
	[77112] = {
		Title = "Chronicle 9-2: The Swarm on the Mountain",
		Summary = "Hunt 30 Centipedes and 10 Dolomedes on the slopes of Kamidal Mountain (dic_fild01), outside El Dicastes.",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Centipedes and 10 Dolomedes on the slopes of Kamidal Mountain (dic_fild01), outside El Dicastes.<br><br>How to get there:<br>1. Far from El Dicastes? From the Allied camp, the Teleport Cat (207, 234) goes to Manuk Field, and the Teleport Cat there (135, 49) to Near El Dicastes. The Allied Scout east of Morroc (moc_fild20, 345, 182) lets you through the rift to the camp.<br><br>Route: <NAVI>[Hunting ground: dic_fild01]<INFO>dic_fild01,159,264,0,000,0</INFO></NAVI>" },
	},
	[77113] = {
		Title = "Chronicle 9-3: What the Swarm Leaves",
		Summary = "Bring Warden Kahlis 8 Bug Legs from the Centipedes and 5 White Spider Limbs from the Dolomedes, at the gate of El Dicastes (156, 270).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Warden Kahlis 8 Bug Legs from the Centipedes and 5 White Spider Limbs from the Dolomedes, at the gate of El Dicastes (156, 270).<br><br>How to get there:<br>1. Far from El Dicastes? From the Allied camp, the Teleport Cat (207, 234) goes to Manuk Field, and the Teleport Cat there (135, 49) to Near El Dicastes. The Allied Scout east of Morroc (moc_fild20, 345, 182) lets you through the rift to the camp.<br><br>Route: <NAVI>[Warden Kahlis]<INFO>dic_fild01,156,270,0,000,0</INFO></NAVI>" },
	},
	[77114] = {
		Title = "Chronicle 9-4: The Hive Under Kamidal",
		Summary = "Enter the Scaraba Hole under Kamidal Mountain (dic_dun01). Its entrance is at the west end of dic_fild01 (24, 79).",
		IconName = "ico_nq.bmp",
		Description = { "Enter the Scaraba Hole under Kamidal Mountain (dic_dun01). Its entrance is at the west end of dic_fild01 (24, 79).<br><br>How to get there:<br>1. Far from El Dicastes? From the Allied camp, the Teleport Cat (207, 234) goes to Manuk Field, and the Teleport Cat there (135, 49) to Near El Dicastes. The Allied Scout east of Morroc (moc_fild20, 345, 182) lets you through the rift to the camp.<br><br>Route: <NAVI>[Rift-Touched Scaraba: dic_dun01]<INFO>dic_dun01,366,45,0,000,0</INFO></NAVI>" },
	},
	[77115] = {
		Title = "Chronicle 9-5: A Shard of the Seal",
		Summary = "Return to Warden Kahlis at the gate of El Dicastes (156, 270).",
		IconName = "ico_nq.bmp",
		Description = { "Return to Warden Kahlis at the gate of El Dicastes (156, 270).<br><br>How to get there:<br>1. From the Scaraba Hole, the way out (371, 44) leads back to dic_fild01. Kahlis waits by the city gate (156, 270).<br><br>Route: <NAVI>[Warden Kahlis]<INFO>dic_fild01,156,270,0,000,0</INFO></NAVI>" },
	},
	[77031] = {
		Title = "Chronicle 10-1: The Church of Freya",
		Summary = "Travel to Rachel, holy city of Arunafeltz, and find Sister Ilyana (141, 146).",
		IconName = "ico_nq.bmp",
		Description = { "Travel to Rachel, holy city of Arunafeltz, and find Sister Ilyana (141, 146).<br><br>How to get there:<br>1. From El Dicastes: on dic_fild01, the way south (69, 23) leads to dic_fild02. Its Dimensional Transporter (241, 31) takes you into the Dimensional Gap.<br>2. In the Gap, the way south (122, 48) leads to the rift gorge (moc_fild22b). The Rift Guard there (37, 196) walks you out to Morroc's fields (moc_fild20).<br>3. From there, follow the Route link to Rachel, holy city of Arunafeltz. Sister Ilyana is at (141, 146).<br><br>Route: <NAVI>[Sister Ilyana]<INFO>rachel,141,146,0,000,0</INFO></NAVI>" },
	},
	[77032] = {
		Title = "Chronicle 10-2: Under the Mountain",
		Summary = "Hunt 30 Fire Imps and 15 Kasa in Thor's Volcano (thor_v01), south of Veins.",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Fire Imps and 15 Kasa in Thor's Volcano (thor_v01), south of Veins.<br><br>Route: <NAVI>[Hunting ground: thor_v01]<INFO>thor_v01,21,229,0,000,0</INFO></NAVI>" },
	},
	[77033] = {
