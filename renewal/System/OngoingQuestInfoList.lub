	[77011] = {
		Title = "Chronicle 3-1: The Desert Seer",
		Summary = "Travel to Morroc, now a city in ruins (a Kafra Employee in Payon can teleport you there), and find Nafisa the seer in the north of the city (156, 286).",
		IconName = "ico_nq.bmp",
		Description = { "Travel to Morroc, now a city in ruins (a Kafra Employee in Payon can teleport you there), and find Nafisa the seer in the north of the city (156, 286).<br><br>How to get there:<br>1. No open road leads into Morroc: the Continental Guard has closed the desert around it. Talk to a Kafra Employee in Payon (175, 226), choose Teleport Service, then Morocc (1,200 zeny). The Kafras in Prontera can send you too.<br>2. In Morroc, Nafisa stands in the north of the city (156, 286). She is marked on your minimap when you arrive.<br>3. Walked into the closed desert (moc_fild20) anyway? Talk to a Continental Guard at its edge and choose Ask What Happened, then Ask About Guard's Location, then Please do. He sends you to Morroc for free.<br><br>Route: <NAVI>[Kafra in Payon: Teleport to Morocc]<INFO>payon,175,226,0,000,0</INFO></NAVI>" },
	},
	[77012] = {
		Title = "Chronicle 3-2: Beneath the Sphinx",
		Summary = "Hunt 30 Drainliars and 10 Matyrs on the first level of the Sphinx (in_sphinx1), a short walk west of Morroc.",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Drainliars and 10 Matyrs on the first level of the Sphinx (in_sphinx1), a short walk west of Morroc.<br><br>How to get there:<br>1. Leave Morroc by its west gate (24, 164). In the desert beyond (moc_fild19), the entrance to the Sphinx stands near the middle of the map (98, 99).<br>2. Requiems and Zeroms (level 70) roam the same level and attack on sight. Bring potions, and keep close to the entrance if they swarm you.<br><br>Route: <NAVI>[Hunting ground: in_sphinx1]<INFO>in_sphinx1,288,10,0,000,0</INFO></NAVI>" },
	},
	[77013] = {
		Title = "Chronicle 3-3: Omens of the Desert",
		Summary = "Nafisa reads omens in what the Sphinx's creatures carry. Bring her 8 Wings of Red Bat and 5 Animal Skins in Morroc (156, 286).",
		IconName = "ico_nq.bmp",
		Description = { "Nafisa reads omens in what the Sphinx's creatures carry. Bring her 8 Wings of Red Bat and 5 Animal Skins in Morroc (156, 286).<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Nafisa the Seer]<INFO>morocc,156,286,0,000,0</INFO></NAVI>" },
	},
	[77014] = {
		Title = "Chronicle 3-4: The Pyramid's Priest",
		Summary = "Enter the Pyramids northwest of Morroc and reach the third level (moc_pryd03).",
		IconName = "ico_nq.bmp",
		Description = { "Enter the Pyramids northwest of Morroc and reach the third level (moc_pryd03).<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Bound Priest of Osiris: moc_pryd03]<INFO>moc_pryd03,100,92,0,000,0</INFO></NAVI>" },
	},
	[77015] = {
		Title = "Chronicle 3-5: The Seer's Warning",
		Summary = "Return to Nafisa in Morroc (156, 286) and tell her about the priest.",
		IconName = "ico_nq.bmp",
		Description = { "Return to Nafisa in Morroc (156, 286) and tell her about the priest.<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Nafisa the Seer]<INFO>morocc,156,286,0,000,0</INFO></NAVI>" },
	},
	[77016] = {
		Title = "Chronicle 4-1: A Letter for the Magister",
		Summary = "Bring Nafisa's letter to Magister Ivo in Geffen (206, 116). From Morroc, a Kafra Employee can teleport you to Prontera; Geffen is a walk west from there.",
		IconName = "ico_nq.bmp",
		Description = { "Bring Nafisa's letter to Magister Ivo in Geffen (206, 116). From Morroc, a Kafra Employee can teleport you to Prontera; Geffen is a walk west from there.<br><br>How to get there:<br>1. No open road leads out of Morroc. Talk to the Kafra Employee in the north of Morroc (160, 258), choose Teleport Service, then Prontera (1,200 zeny).<br>2. From Prontera, the Route link leads west to Geffen. Magister Ivo stands near the east gate (206, 116) and is marked on your minimap when you arrive.<br><br>Route: <NAVI>[Magister Ivo]<INFO>geffen,206,116,0,000,0</INFO></NAVI>" },
	},
	[77017] = {
		Title = "Chronicle 4-2: The Orc Warband",
		Summary = "Hunt 30 Zenorcs and 20 Orc Skeletons on the second level of the Orc Dungeon (orcsdun02), beneath the orc village west of Geffen.",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Zenorcs and 20 Orc Skeletons on the second level of the Orc Dungeon (orcsdun02), beneath the orc village west of Geffen.<br><br>How to get there:<br>1. The Kafra Employees in Geffen can teleport you to the Orc Dungeon (1,700 zeny), or the Route link walks you there.<br><br>Route: <NAVI>[Hunting ground: orcsdun02]<INFO>orcsdun02,180,17,0,000,0</INFO></NAVI>" },
	},
	[77018] = {
		Title = "Chronicle 4-3: Trophies of War",
		Summary = "Bring Magister Ivo 10 Zenorc's Fangs and 6 Orc's Fangs from the orcs, in Geffen (206, 116).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Magister Ivo 10 Zenorc's Fangs and 6 Orc's Fangs from the orcs, in Geffen (206, 116).<br><br>How to get there:<br>1. Still in Morroc? No open road leads out: its Kafra Employee (160, 258) can teleport you to Prontera (1,200 zeny), and Geffen is a walk west from there.<br><br>Route: <NAVI>[Magister Ivo]<INFO>geffen,206,116,0,000,0</INFO></NAVI>" },
	},
	[77019] = {
		Title = "Chronicle 4-4: Beneath the Tower",
