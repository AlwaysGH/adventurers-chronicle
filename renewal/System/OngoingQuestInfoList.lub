	[77036] = {
		Title = "Chronicle 11-1: The Valkyrie's Herald",
		Summary = "Go to Hugel, the seaside village in the far north, and find Brynjar the Herald (101, 56).",
		IconName = "ico_nq.bmp",
		Description = { "Go to Hugel, the seaside village in the far north, and find Brynjar the Herald (101, 56).<br><br>Route: <NAVI>[Brynjar the Herald]<INFO>hugel,101,56,0,000,0</INFO></NAVI>" },
	},
	[77037] = {
		Title = "Chronicle 11-2: Fallen Spirits",
		Summary = "Hunt 30 Skogul and 30 Frus on the second floor of Odin's Temple (odin_tem02). The Boatman in Hugel (209, 109) sails there.",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Skogul and 30 Frus on the second floor of Odin's Temple (odin_tem02). The Boatman in Hugel (209, 109) sails there.<br><br>How to get there:<br>1. Hugel: talk to the Boatman (209, 109) and choose Sure! (800 zeny). He sails you to the first floor of Odin's Temple (odin_tem01).<br>2. First floor: walk to the east end. The paths at (378, 182) and (383, 334) lead up to the second floor (odin_tem02), the hunting ground.<br>3. To go home, the Boatman on the first floor (93, 146) sails you back to Hugel.<br><br>Route: <NAVI>[Boatman to Odin's Temple: hugel]<INFO>hugel,209,109,0,000,0</INFO></NAVI>" },
	},
	[77038] = {
		Title = "Chronicle 11-3: Runes of the Gods",
		Summary = "Bring Brynjar 5 Runes of Darkness in Hugel (101, 56).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Brynjar 5 Runes of Darkness in Hugel (101, 56).<br><br>How to get there:<br>1. In Odin's Temple? Go down to the first floor (odin_tem01) and ask the Boatman there (93, 146) to sail you back to Hugel.<br><br>Route: <NAVI>[Brynjar the Herald]<INFO>hugel,101,56,0,000,0</INFO></NAVI>" },
	},
	[77039] = {
		Title = "Chronicle 11-4: The Fallen Valkyrie",
		Summary = "Ascend to the upper hall of Odin's Temple (odin_tem03). The Boatman in Hugel (209, 109) sails there.",
		IconName = "ico_nq.bmp",
		Description = { "Ascend to the upper hall of Odin's Temple (odin_tem03). The Boatman in Hugel (209, 109) sails there.<br><br>How to get there:<br>1. Hugel: talk to the Boatman (209, 109) and choose Sure! (800 zeny). He sails you to the first floor of Odin's Temple (odin_tem01).<br>2. First floor: walk to the east end. The paths at (378, 182) and (383, 334) lead up to the second floor (odin_tem02).<br>3. Second floor: the ways up at (153, 349) and (261, 377) lead to the upper hall (odin_tem03). The Fallen Valkyrie's Shade appears a few seconds after you arrive.<br><br>Route: <NAVI>[Boatman to Odin's Temple: hugel]<INFO>hugel,209,109,0,000,0</INFO></NAVI>" },
	},
	[77040] = {
		Title = "Chronicle 11-5: The Light of Bifrost",
		Summary = "Return to Brynjar the Herald in Hugel (101, 56).",
		IconName = "ico_nq.bmp",
		Description = { "Return to Brynjar the Herald in Hugel (101, 56).<br><br>How to get there:<br>1. In Odin's Temple? Go down to the first floor (odin_tem01) and ask the Boatman there (93, 146) to sail you back to Hugel.<br><br>Route: <NAVI>[Brynjar the Herald]<INFO>hugel,101,56,0,000,0</INFO></NAVI>" },
	},
	[77116] = {
		Title = "Chronicle 12-1: The Village Under the Bridge",
		Summary = "Go to Mora, the Laphine village at the foot of Bifrost, and find Elder Mirrel (114, 96).",
		IconName = "ico_nq.bmp",
		Description = { "Go to Mora, the Laphine village at the foot of Bifrost, and find Elder Mirrel (114, 96).<br><br>How to get there:<br>1. Follow the Route link to the Allied Scout east of Morroc (moc_fild20, 345, 182). He lets you through the rift to the Allied camp.<br>2. In the camp, the Teleport Cat (207, 234) goes to Near Splendide (10,000 zeny). On spl_fild02, the Teleport Cat (53, 242) goes to Entrance to Mora (55,000 zeny).<br>3. On bif_fild02, knock on the Small Hole in the hill (285, 332). It opens into Mora. Elder Mirrel stands in the village centre (114, 96).<br><br>Route: <NAVI>[Allied Scout: moc_fild20]<INFO>moc_fild20,345,182,0,000,0</INFO></NAVI>" },
	},
	[77117] = {
		Title = "Chronicle 12-2: The Bridge Fields",
		Summary = "Hunt 30 Little Fatum and 20 Miming on the fields of Bifrost outside Mora (bif_fild02).",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Little Fatum and 20 Miming on the fields of Bifrost outside Mora (bif_fild02).<br><br>How to get there:<br>1. Mora's east door (182, 74) leads out to bif_fild02, the hunting ground.<br><br>Route: <NAVI>[Hunting ground: bif_fild02]<INFO>bif_fild02,291,323,0,000,0</INFO></NAVI>" },
	},
	[77118] = {
		Title = "Chronicle 12-3: Dust of the Rainbow",
		Summary = "Bring Elder Mirrel 5 Angel Magic Powder from the Little Fatum and 5 Golden Feathers from the Miming, in Mora (114, 96).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Elder Mirrel 5 Angel Magic Powder from the Little Fatum and 5 Golden Feathers from the Miming, in Mora (114, 96).<br><br>How to get there:<br>1. Far from Mora? Through the rift (the Allied Scout east of Morroc, moc_fild20, 345, 182) to the Allied camp, its Teleport Cat (207, 234) to Near Splendide, the Teleport Cat there (53, 242) to Entrance to Mora, then knock on the Small Hole (285, 332).<br><br>Route: <NAVI>[Elder Mirrel]<INFO>mora,114,96,0,000,0</INFO></NAVI>" },
	},
	[77119] = {
		Title = "Chronicle 12-4: The Thornheart",
		Summary = "Return to the fields of Bifrost outside Mora (bif_fild02) and slay the Thornheart Mantis.",
		IconName = "ico_nq.bmp",
		Description = { "Return to the fields of Bifrost outside Mora (bif_fild02) and slay the Thornheart Mantis.<br><br>How to get there:<br>1. Mora's east door (182, 74) leads out to bif_fild02. The Thornheart Mantis appears a few seconds after you arrive.<br><br>Route: <NAVI>[Thornheart Mantis: bif_fild02]<INFO>bif_fild02,291,323,0,000,0</INFO></NAVI>" },
	},
	[77120] = {
		Title = "Chronicle 12-5: Seven Colours",
		Summary = "Return to Elder Mirrel in Mora (114, 96).",
		IconName = "ico_nq.bmp",
		Description = { "Return to Elder Mirrel in Mora (114, 96).<br><br>How to get there:<br>1. On bif_fild02, knock on the Small Hole in the hill (285, 332). It opens into Mora.<br><br>Route: <NAVI>[Elder Mirrel]<INFO>mora,114,96,0,000,0</INFO></NAVI>" },
	},
	[77121] = {
		Title = "Chronicle 13-1: The Gate of Eclage",
		Summary = "Go to the fields of Eclage (ecl_fild01) and find Captain Sylwen outside the city gate (102, 307).",
		IconName = "ico_nq.bmp",
		Description = { "Go to the fields of Eclage (ecl_fild01) and find Captain Sylwen outside the city gate (102, 307).<br><br>How to get there:<br>1. From Mora, the east door (182, 74) leads out to bif_fild02.<br>2. On bif_fild02, the way in the north-east (292, 351) leads to ecl_fild01. Walk north-west to the city gate; Captain Sylwen stands just outside it (102, 307).<br><br>Route: <NAVI>[Captain Sylwen]<INFO>ecl_fild01,102,307,0,000,0</INFO></NAVI>" },
	},
	[77122] = {
		Title = "Chronicle 13-2: The Ashen Halls",
		Summary = "Hunt 25 Cenere and 20 Antique Books on the second floor of the keepers' tower (ecl_tdun02).",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 25 Cenere and 20 Antique Books on the second floor of the keepers' tower (ecl_tdun02).<br><br>How to get there:<br>1. The tower's door is in the south of ecl_fild01 (182, 82).<br>2. Floor 1: the stairs up (67, 106) lead to the second floor (ecl_tdun02), the hunting ground.<br><br>Route: <NAVI>[Hunting ground: ecl_tdun02]<INFO>ecl_tdun02,60,88,0,000,0</INFO></NAVI>" },
	},
	[77123] = {
		Title = "Chronicle 13-3: Ash and Pages",
		Summary = "Bring Captain Sylwen 5 Mould Powder from the Cenere and 5 Worn Out Pages from the Antique Books, outside the gate of Eclage (102, 307).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Captain Sylwen 5 Mould Powder from the Cenere and 5 Worn Out Pages from the Antique Books, outside the gate of Eclage (102, 307).<br><br>How to get there:<br>1. Far from Eclage? From Mora, the east door (182, 74) leads to bif_fild02, and its north-east way (292, 351) to ecl_fild01. Captain Sylwen stands outside the city gate (102, 307).<br><br>Route: <NAVI>[Captain Sylwen]<INFO>ecl_fild01,102,307,0,000,0</INFO></NAVI>" },
	},
	[77124] = {
		Title = "Chronicle 13-4: The Last Keeper",
		Summary = "Climb to the third floor of the keepers' tower (ecl_tdun03) and free the Withered Steward.",
		IconName = "ico_nq.bmp",
		Description = { "Climb to the third floor of the keepers' tower (ecl_tdun03) and free the Withered Steward.<br><br>How to get there:<br>1. The tower's door is in the south of ecl_fild01 (182, 82). Floor 1: the stairs up (67, 106). Floor 2: the stairs up (52, 9) lead to the third floor.<br>2. The Withered Steward appears a few seconds after you arrive.<br><br>Route: <NAVI>[Withered Steward: ecl_tdun03]<INFO>ecl_tdun03,47,13,0,000,0</INFO></NAVI>" },
	},
	[77125] = {
		Title = "Chronicle 13-5: The Roots Below",
		Summary = "Return to Captain Sylwen outside the gate of Eclage (102, 307).",
		IconName = "ico_nq.bmp",
		Description = { "Return to Captain Sylwen outside the gate of Eclage (102, 307).<br><br>How to get there:<br>1. From the tower, take the stairs down to the first floor and its door (61, 11) back out to ecl_fild01. Sylwen stands outside the city gate (102, 307).<br><br>Route: <NAVI>[Captain Sylwen]<INFO>ecl_fild01,102,307,0,000,0</INFO></NAVI>" },
	},
	[77126] = {
		Title = "Chronicle 14-1: The Buried City",
		Summary = "Go to Verus, the buried city beneath Juperos, and find Professor Hendrik at the excavation camp (verus04, 190, 180).",
		IconName = "ico_nq.bmp",
		Description = { "Go to Verus, the buried city beneath Juperos, and find Professor Hendrik at the excavation camp (verus04, 190, 180).<br><br>How to get there:<br>1. From Juno, follow the Route link into the Juperos ruins (juperos_01). Its east tunnel (245, 87) leads to the excavation site (ver_eju).<br>2. On ver_eju, the way south (107, 36) leads into the tunnel (ver_tunn). The tunnel's west end (10, 36) opens into Verus (verus04). Professor Hendrik works near the excavators' camp (190, 180).<br><br>Route: <NAVI>[The way to Verus: juperos_01]<INFO>juperos_01,245,87,0,000,0</INFO></NAVI>" },
	},
	[77127] = {
		Title = "Chronicle 14-2: The Waking City",
		Summary = "Hunt 30 Repair Robots and 15 Exploration Rovers in the old city of Verus (verus03).",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Repair Robots and 15 Exploration Rovers in the old city of Verus (verus03).<br><br>How to get there:<br>1. From Professor Hendrik's camp, the ways north (121, 267) and (44, 267) lead to the old city (verus03), the hunting ground.<br><br>Route: <NAVI>[Way to the old city: verus04]<INFO>verus04,121,267,0,000,0</INFO></NAVI>" },
	},
	[77128] = {
		Title = "Chronicle 14-3: Iron and Orders",
		Summary = "Bring Professor Hendrik 5 Used Iron Plates from the Repair Robots and 10 Iron from the Exploration Rovers, in Verus (190, 180).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Professor Hendrik 5 Used Iron Plates from the Repair Robots and 10 Iron from the Exploration Rovers, in Verus (190, 180).<br><br>How to get there:<br>1. Far from Verus? From Juno, go down into the Juperos ruins (juperos_01). Its east tunnel (245, 87) leads to the excavation (ver_eju), its south way (107, 36) to the tunnel (ver_tunn), and the tunnel's west end (10, 36) to Verus (verus04).<br><br>Route: <NAVI>[Professor Hendrik]<INFO>verus04,190,180,0,000,0</INFO></NAVI>" },
	},
	[77129] = {
		Title = "Chronicle 14-4: The Excavator Prime",
		Summary = "Go back up to the excavation site (ver_eju) and destroy the Excavator Prime.",
		IconName = "ico_nq.bmp",
		Description = { "Go back up to the excavation site (ver_eju) and destroy the Excavator Prime.<br><br>How to get there:<br>1. From Verus, the way east (204, 163) leads into the tunnel (ver_tunn), and its north end (84, 86) up to the excavation site (ver_eju). The Excavator Prime appears a few seconds after you arrive.<br><br>Route: <NAVI>[Excavator Prime: ver_eju]<INFO>ver_eju,13,148,0,000,0</INFO></NAVI>" },
	},
	[77130] = {
		Title = "Chronicle 14-5: Champion of Rune-Midgard",
		Summary = "Return to Professor Hendrik in Verus (190, 180).",
		IconName = "ico_nq.bmp",
		Description = { "Return to Professor Hendrik in Verus (190, 180).<br><br>How to get there:<br>1. From the excavation site, the way south (107, 36) leads into the tunnel (ver_tunn), and its west end (10, 36) to Verus. Hendrik is at his camp (190, 180).<br><br>Route: <NAVI>[Professor Hendrik]<INFO>verus04,190,180,0,000,0</INFO></NAVI>" },
	},
}
