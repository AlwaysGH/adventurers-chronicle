-- GENERATED by tools/build.ps1 from tools/story.ps1 (ASCII only).
QuestInfoList = {
	[77001] = {
		Title = "Chronicle 1-1: The Knight at the Fountain",
		Summary = "The Prontera Knights are looking for adventurers. Find Sir Leonhart near the central fountain of Prontera (157, 190).",
		IconName = "ico_nq.bmp",
		Description = { "The Prontera Knights are looking for adventurers. Find Sir Leonhart near the central fountain of Prontera (157, 190).<br><br>Route: <NAVI>[Sir Leonhart]<INFO>prontera,157,190,0,000,0</INFO></NAVI>" },
	},
	[77002] = {
		Title = "Chronicle 1-2: Clearing the Southern Fields",
		Summary = "Monsters around Prontera have grown bold. Hunt 20 Porings and 15 Lunatics in the fields south of Prontera (prt_fild08). Track the count in the quest window (Alt+U).",
		IconName = "ico_nq.bmp",
		Description = { "Monsters around Prontera have grown bold. Hunt 20 Porings and 15 Lunatics in the fields south of Prontera (prt_fild08). Track the count in the quest window (Alt+U).<br><br>Route: <NAVI>[Hunting ground: prt_fild08]<INFO>prt_fild08,170,375,0,000,0</INFO></NAVI>" },
	},
	[77003] = {
		Title = "Chronicle 1-3: Proof for the Knights",
		Summary = "Leonhart needs proof for the Knight Captain. Bring him 10 Jellopy and 5 Clover in Prontera (157, 190).",
		IconName = "ico_nq.bmp",
		Description = { "Leonhart needs proof for the Knight Captain. Bring him 10 Jellopy and 5 Clover in Prontera (157, 190).<br><br>Route: <NAVI>[Sir Leonhart]<INFO>prontera,157,190,0,000,0</INFO></NAVI>" },
	},
	[77004] = {
		Title = "Chronicle 1-4: Into the Culvert",
		Summary = "Volunteer with the Recruiter in Prontera, then enter the Prontera Culvert and reach its second level (prt_sewb2). Whatever is driving the Thief Bugs waits there.",
		IconName = "ico_nq.bmp",
		Description = { "Volunteer with the Recruiter in Prontera, then enter the Prontera Culvert and reach its second level (prt_sewb2). Whatever is driving the Thief Bugs waits there.<br><br>How to get there:<br>1. Prontera: go into the north-west building (door at 45, 346). The Recruiter stands inside (88, 105).<br>2. Talk to the Recruiter and choose Volunteer. You get a few potions, and the Recruiter can send you straight to the Culvert entrance (now and any time later).<br>3. Field west of Prontera (prt_fild05): the Culvert Guardian (270, 212) lets volunteers in.<br>4. Culvert level 1: take the stairs in the east (188, 247) down to level 2. The Culvert Brood Lord appears a few seconds after you arrive.<br><br>Route: <NAVI>[Culvert Recruiter: prt_in]<INFO>prt_in,88,105,0,000,0</INFO></NAVI>" },
	},
	[77005] = {
		Title = "Chronicle 1-5: Report to Leonhart",
		Summary = "Tell Sir Leonhart in Prontera (157, 190) what you found in the Culvert.",
		IconName = "ico_nq.bmp",
		Description = { "Tell Sir Leonhart in Prontera (157, 190) what you found in the Culvert.<br><br>Route: <NAVI>[Sir Leonhart]<INFO>prontera,157,190,0,000,0</INFO></NAVI>" },
	},
	[77006] = {
		Title = "Chronicle 2-1: The Archer Captain",
		Summary = "Travel south to Payon, the mountain village of archers, and find Captain Hwarang (154, 182).",
		IconName = "ico_nq.bmp",
		Description = { "Travel south to Payon, the mountain village of archers, and find Captain Hwarang (154, 182).<br><br>Route: <NAVI>[Captain Hwarang]<INFO>payon,154,182,0,000,0</INFO></NAVI>" },
	},
	[77007] = {
		Title = "Chronicle 2-2: The Restless Dead",
		Summary = "Hunt 25 Zombies and 20 Skeletons on the first level of the Payon Cave (pay_dun00), north of the Archer Village.",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 25 Zombies and 20 Skeletons on the first level of the Payon Cave (pay_dun00), north of the Archer Village.<br><br>Route: <NAVI>[Hunting ground: pay_dun00]<INFO>pay_dun00,21,183,0,000,0</INFO></NAVI>" },
	},
	[77008] = {
		Title = "Chronicle 2-3: Bones and Nails",
		Summary = "The village shaman wants to study what raises the dead. Bring Captain Hwarang 10 Decayed Nails and 5 Skel-Bones in Payon (154, 182).",
		IconName = "ico_nq.bmp",
		Description = { "The village shaman wants to study what raises the dead. Bring Captain Hwarang 10 Decayed Nails and 5 Skel-Bones in Payon (154, 182).<br><br>Route: <NAVI>[Captain Hwarang]<INFO>payon,154,182,0,000,0</INFO></NAVI>" },
	},
	[77009] = {
		Title = "Chronicle 2-4: The Captain Below",
		Summary = "Descend to the second level of the Payon Cave (pay_dun01). The soldiers buried there once had a commander; if he has risen, he must fall again.",
		IconName = "ico_nq.bmp",
		Description = { "Descend to the second level of the Payon Cave (pay_dun01). The soldiers buried there once had a commander; if he has risen, he must fall again.<br><br>Route: <NAVI>[Restless Cave Captain: pay_dun01]<INFO>pay_dun01,19,33,0,000,0</INFO></NAVI>" },
	},
	[77010] = {
		Title = "Chronicle 2-5: Words of the Dead",
		Summary = "Tell Captain Hwarang in Payon (154, 182) what the dead soldier said.",
		IconName = "ico_nq.bmp",
		Description = { "Tell Captain Hwarang in Payon (154, 182) what the dead soldier said.<br><br>Route: <NAVI>[Captain Hwarang]<INFO>payon,154,182,0,000,0</INFO></NAVI>" },
	},
	[77011] = {
		Title = "Chronicle 3-1: The Desert Seer",
		Summary = "Travel to Morroc, now a city in ruins (a Kafra Employee in Payon can teleport you there), and find Nafisa the seer in the north of the city (156, 286).",
		IconName = "ico_nq.bmp",
		Description = { "Travel to Morroc, now a city in ruins (a Kafra Employee in Payon can teleport you there), and find Nafisa the seer in the north of the city (156, 286).<br><br>How to get there:<br>1. No open road leads into Morroc: the Continental Guard has closed the desert around it. Talk to a Kafra Employee in Payon (175, 226), choose Teleport Service, then Morocc (1,200 zeny). The Kafras in Prontera can send you too.<br>2. In Morroc, Nafisa stands in the north of the city (156, 286). She is marked on your minimap when you arrive.<br>3. Walked into the closed desert (moc_fild20) anyway? Talk to a Continental Guard at its edge and choose Ask What Happened, then Ask About Guard's Location, then Please do. He sends you to Morroc for free.<br><br>Route: <NAVI>[Kafra in Payon: Teleport to Morocc]<INFO>payon,175,226,0,000,0</INFO></NAVI>" },
	},
	[77012] = {
		Title = "Chronicle 3-2: Beneath the Sphinx",
		Summary = "Hunt 30 Drainliars and 10 Matyrs on the first level of the Sphinx (in_sphinx1), a short walk west of Morroc.",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Drainliars and 10 Matyrs on the first level of the Sphinx (in_sphinx1), a short walk west of Morroc.<br><br>How to get there:<br>1. Leave Morroc by its west gate (24, 164). In the desert beyond (moc_fild19), the entrance to the Sphinx stands near the middle of the map (98, 99).<br>2. Requiems and Zeroms (level 70) roam the same level and attack on sight. Bring potions, and keep close to the entrance if they swarm you.<br><br>Route: <NAVI>[Hunting ground: in_sphinx1]<INFO>in_sphinx1,288,10,0,000,0</INFO></NAVI>" },
	},
	[77013] = {
		Title = "Chronicle 3-3: Omens of the Desert",
		Summary = "Nafisa reads omens in what the Sphinx's creatures carry. Bring her 8 Wings of Red Bat and 5 Animal Skins in Morroc (156, 286).",
		IconName = "ico_nq.bmp",
		Description = { "Nafisa reads omens in what the Sphinx's creatures carry. Bring her 8 Wings of Red Bat and 5 Animal Skins in Morroc (156, 286).<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Nafisa the Seer]<INFO>morocc,156,286,0,000,0</INFO></NAVI>" },
	},
	[77014] = {
		Title = "Chronicle 3-4: The Pyramid's Priest",
		Summary = "Enter the Pyramids northwest of Morroc and reach the third level (moc_pryd03).",
		IconName = "ico_nq.bmp",
		Description = { "Enter the Pyramids northwest of Morroc and reach the third level (moc_pryd03).<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Bound Priest of Osiris: moc_pryd03]<INFO>moc_pryd03,100,92,0,000,0</INFO></NAVI>" },
	},
	[77015] = {
		Title = "Chronicle 3-5: The Seer's Warning",
		Summary = "Return to Nafisa in Morroc (156, 286) and tell her about the priest.",
		IconName = "ico_nq.bmp",
		Description = { "Return to Nafisa in Morroc (156, 286) and tell her about the priest.<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Nafisa the Seer]<INFO>morocc,156,286,0,000,0</INFO></NAVI>" },
	},
	[77016] = {
		Title = "Chronicle 4-1: A Letter for the Magister",
		Summary = "Bring Nafisa's letter to Magister Ivo in Geffen (206, 116). From Morroc, a Kafra Employee can teleport you to Prontera; Geffen is a walk west from there.",
		IconName = "ico_nq.bmp",
		Description = { "Bring Nafisa's letter to Magister Ivo in Geffen (206, 116). From Morroc, a Kafra Employee can teleport you to Prontera; Geffen is a walk west from there.<br><br>How to get there:<br>1. No open road leads out of Morroc. Talk to the Kafra Employee in the north of Morroc (160, 258), choose Teleport Service, then Prontera (1,200 zeny).<br>2. From Prontera, the Route link leads west to Geffen. Magister Ivo stands near the east gate (206, 116) and is marked on your minimap when you arrive.<br><br>Route: <NAVI>[Magister Ivo]<INFO>geffen,206,116,0,000,0</INFO></NAVI>" },
	},
	[77017] = {
		Title = "Chronicle 4-2: The Orc Warband",
		Summary = "Hunt 30 Zenorcs and 20 Orc Skeletons on the second level of the Orc Dungeon (orcsdun02), beneath the orc village west of Geffen.",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 Zenorcs and 20 Orc Skeletons on the second level of the Orc Dungeon (orcsdun02), beneath the orc village west of Geffen.<br><br>How to get there:<br>1. The Kafra Employees in Geffen can teleport you to the Orc Dungeon (1,700 zeny), or the Route link walks you there.<br><br>Route: <NAVI>[Hunting ground: orcsdun02]<INFO>orcsdun02,180,17,0,000,0</INFO></NAVI>" },
	},
	[77018] = {
		Title = "Chronicle 4-3: Trophies of War",
		Summary = "Bring Magister Ivo 10 Zenorc's Fangs and 6 Orc's Fangs from the orcs, in Geffen (206, 116).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Magister Ivo 10 Zenorc's Fangs and 6 Orc's Fangs from the orcs, in Geffen (206, 116).<br><br>How to get there:<br>1. Still in Morroc? No open road leads out: its Kafra Employee (160, 258) can teleport you to Prontera (1,200 zeny), and Geffen is a walk west from there.<br><br>Route: <NAVI>[Magister Ivo]<INFO>geffen,206,116,0,000,0</INFO></NAVI>" },
	},
	[77019] = {
		Title = "Chronicle 4-4: Beneath the Tower",
		Summary = "Enter the Geffen Dungeon beneath the tower and reach its second level (gef_dun01).",
		IconName = "ico_nq.bmp",
		Description = { "Enter the Geffen Dungeon beneath the tower and reach its second level (gef_dun01).<br><br>How to get there:<br>1. Still in Morroc? No open road leads out: its Kafra Employee (160, 258) can teleport you to Prontera (1,200 zeny), and Geffen is a walk west from there.<br><br>Route: <NAVI>[Nightmare of the Tower: gef_dun01]<INFO>gef_dun01,115,236,0,000,0</INFO></NAVI>" },
	},
	[77020] = {
