		Summary = "Bring Sister Ilyana 3 Burning Hearts and 5 Burning Hair, in Rachel (141, 146).",
		IconName = "ico_nq.bmp",
		Description = { "Bring Sister Ilyana 3 Burning Hearts and 5 Burning Hair, in Rachel (141, 146).<br><br>Route: <NAVI>[Sister Ilyana]<INFO>rachel,141,146,0,000,0</INFO></NAVI>" },
