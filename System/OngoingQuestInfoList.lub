		Summary = "Tell Captain Hwarang in Payon (154, 182) what the dead soldier said.",
		IconName = "ico_nq.bmp",
		Description = { "Tell Captain Hwarang in Payon (154, 182) what the dead soldier said.<br><br>Route: <NAVI>[Captain Hwarang]<INFO>payon,154,182,0,000,0</INFO></NAVI>" },
