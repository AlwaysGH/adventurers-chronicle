	[77011] = {
		Title = "Chronicle 3-1: The Desert Seer",
		Summary = "Travel to Morroc (a Kafra Employee in Payon can teleport you there) and find Nafisa the seer in the north of the city (156, 286).",
		IconName = "ico_nq.bmp",
		Description = { "Travel to Morroc (a Kafra Employee in Payon can teleport you there) and find Nafisa the seer in the north of the city (156, 286).<br><br>How to get there:<br>1. No open road leads into Morroc: the Continental Guard has closed the desert around it. Talk to a Kafra Employee in Payon (175, 226), choose Teleport Service, then Morocc (1,200 zeny). The Kafras in Prontera can send you too.<br>2. In Morroc, Nafisa stands in the north of the city (156, 286). She is marked on your minimap when you arrive.<br>3. Walked into the closed desert (moc_fild20) anyway? Talk to a Continental Guard at its edge and choose Ask What Happened, then Ask About Guard's Location, then Please do. He sends you to Morroc for free.<br><br>Route: <NAVI>[Kafra in Payon: Teleport to Morocc]<INFO>payon,175,226,0,000,0</INFO></NAVI>" },
	},
	[77012] = {
		Title = "Chronicle 3-2: Restless Sands",
		Summary = "Hunt 25 Sandmen and 25 Hodes in the Sograt Desert (moc_fild16).",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 25 Sandmen and 25 Hodes in the Sograt Desert (moc_fild16).<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Hunting ground: moc_fild16]<INFO>moc_fild16,124,372,0,000,0</INFO></NAVI>" },
	},
	[77013] = {
		Title = "Chronicle 3-3: Grains of Truth",
		Summary = "Nafisa reads omens in sand. Bring her 10 Grit and 10 Earthworm Peelings in Morroc (156, 286).",
		IconName = "ico_nq.bmp",
		Description = { "Nafisa reads omens in sand. Bring her 10 Grit and 10 Earthworm Peelings in Morroc (156, 286).<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Nafisa the Seer]<INFO>morocc,156,286,0,000,0</INFO></NAVI>" },
	},
	[77014] = {
		Title = "Chronicle 3-4: The Pyramid's Priest",
		Summary = "Enter the Pyramids northwest of Morroc and reach the third level (moc_pryd03).",
		IconName = "ico_nq.bmp",
		Description = { "Enter the Pyramids northwest of Morroc and reach the third level (moc_pryd03).<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Bound Priest of Osiris: moc_pryd03]<INFO>moc_pryd03,100,92,0,000,0</INFO></NAVI>" },
	},
	[77015] = {
		Title = "Chronicle 3-5: The Seer's Warning",
		Summary = "Return to Nafisa in Morroc (156, 286) and tell her about the priest.",
		IconName = "ico_nq.bmp",
		Description = { "Return to Nafisa in Morroc (156, 286) and tell her about the priest.<br><br>How to get there:<br>1. Away from Morroc? No open road leads back in: a Kafra Employee in Payon (175, 226) or Prontera (146, 89) can teleport you to Morocc (1,200 zeny).<br><br>Route: <NAVI>[Nafisa the Seer]<INFO>morocc,156,286,0,000,0</INFO></NAVI>" },
	},
	[77016] = {
		Title = "Chronicle 4-1: A Letter for the Magister",
		Summary = "Bring Nafisa's letter to Magister Ivo in Geffen (206, 116). From Morroc, a Kafra Employee can teleport you to Prontera; Geffen is a walk west from there.",
		IconName = "ico_nq.bmp",
		Description = { "Bring Nafisa's letter to Magister Ivo in Geffen (206, 116). From Morroc, a Kafra Employee can teleport you to Prontera; Geffen is a walk west from there.<br><br>How to get there:<br>1. No open road leads out of Morroc. Talk to the Kafra Employee in the north of Morroc (160, 258), choose Teleport Service, then Prontera (1,200 zeny).<br>2. From Prontera, the Route link leads west to Geffen. Magister Ivo stands near the east gate (206, 116) and is marked on your minimap when you arrive.<br><br>Route: <NAVI>[Magister Ivo]<INFO>geffen,206,116,0,000,0</INFO></NAVI>" },
	},
	[77017] = {
		Title = "Chronicle 4-2: The Orc Warband",
		Summary = "Hunt 30 High Orcs and 20 Orc Archers in the orc lands west of Geffen (gef_fild14).",
		IconName = "ico_nq.bmp",
		Description = { "Hunt 30 High Orcs and 20 Orc Archers in the orc lands west of Geffen (gef_fild14).<br><br>How to get there:<br>1. Still in Morroc? No open road leads out: its Kafra Employee (160, 258) can teleport you to Prontera (1,200 zeny), and Geffen is a walk west from there.<br><br>Route: <NAVI>[Hunting ground: gef_fild14]<INFO>gef_fild14,367,219,0,000,0</INFO></NAVI>" },
	},
	[77018] = {
