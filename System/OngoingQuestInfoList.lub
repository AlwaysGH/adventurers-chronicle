		Description = { "Descend to the second level of the Payon Cave (pay_dun01). The soldiers buried there once had a commander; if he has risen, he must fall again.<br><br>Route: <NAVI>[Restless Cave Captain: pay_dun01]<INFO>pay_dun01,19,33,0,000,0</INFO></NAVI>" },
